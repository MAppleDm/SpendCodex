<?xml version="1.0" encoding="utf-8"?>
<!-- Same policy for Android 12+: the journal and the choices; never the DeepSeek key or the lock. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="spendcodex.db" />
        <include domain="database" path="spendcodex.db-wal" />
        <include domain="database" path="spendcodex.db-shm" />
        <include domain="sharedpref" path="app.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="spendcodex.db" />
        <include domain="database" path="spendcodex.db-wal" />
        <include domain="database" path="spendcodex.db-shm" />
        <include domain="sharedpref" path="app.xml" />
    </device-transfer>
</data-extraction-rules>
